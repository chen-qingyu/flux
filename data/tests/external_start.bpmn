<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_External_Start" targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:process id="Process_external_start" name="外部发生器" isExecutable="true">
        <bpmn:startEvent id="Event_external" name="外部发生器">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_initiatorType" value="external" />
                    <camunda:property name="_entityType" value="customer" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:outgoing>Flow_start_to_task</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_service" name="服务">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_taskType" value="delay" />
                    <camunda:property name="_distributionType" value="static" />
                    <camunda:property name="_staticInterval" value="0" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_start_to_task</bpmn:incoming>
            <bpmn:outgoing>Flow_task_to_end</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="Event_end" name="结束">
            <bpmn:incoming>Flow_task_to_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_start_to_task" sourceRef="Event_external" targetRef="Task_service" />
        <bpmn:sequenceFlow id="Flow_task_to_end" sourceRef="Task_service" targetRef="Event_end" />
    </bpmn:process>
</bpmn:definitions>