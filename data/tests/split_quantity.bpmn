<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_SplitQuantity" targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:process id="Process_split_quantity" isExecutable="true">
        <bpmn:startEvent id="Event_split_quantity" name="外部发生器">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_initiatorType" value="external" />
                    <camunda:property name="_entityType" value="order" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:outgoing>Flow_start_split</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_start_split" sourceRef="Event_split_quantity" targetRef="Activity_split_quantity" />
        <bpmn:task id="Activity_split_quantity" name="按数量拆分">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_taskType" value="split" />
                    <camunda:property name="_method" value="quantity" />
                    <camunda:property name="_oneOff" value="true" />
                    <camunda:property name="_distributionType" value="static" />
                    <camunda:property name="_staticInterval" value="1" />
                    <camunda:property name="_quantityProperty" value="qty" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_start_split</bpmn:incoming>
            <bpmn:outgoing>Flow_split_gateway</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="Flow_split_gateway" sourceRef="Activity_split_quantity" targetRef="Gateway_route" />
        <bpmn:exclusiveGateway id="Gateway_route" name="属性路由">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_criteria" value="property" />
                    <camunda:property name="_propertyName" value="route" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_split_gateway</bpmn:incoming>
            <bpmn:outgoing>Flow_route_get</bpmn:outgoing>
            <bpmn:outgoing>Flow_route_put</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_get" name="获取分支">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_taskType" value="delay" />
                    <camunda:property name="_distributionType" value="static" />
                    <camunda:property name="_staticInterval" value="1" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_route_get</bpmn:incoming>
            <bpmn:outgoing>Flow_get_end</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="Flow_route_get" name="get" sourceRef="Gateway_route" targetRef="Task_get" />
        <bpmn:task id="Task_put" name="放置分支">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_taskType" value="delay" />
                    <camunda:property name="_distributionType" value="static" />
                    <camunda:property name="_staticInterval" value="1" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_route_put</bpmn:incoming>
            <bpmn:outgoing>Flow_put_end</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="Flow_route_put" name="put" sourceRef="Gateway_route" targetRef="Task_put" />
        <bpmn:endEvent id="Event_end" name="结束">
            <bpmn:incoming>Flow_get_end</bpmn:incoming>
            <bpmn:incoming>Flow_put_end</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_get_end" sourceRef="Task_get" targetRef="Event_end" />
        <bpmn:sequenceFlow id="Flow_put_end" sourceRef="Task_put" targetRef="Event_end" />
    </bpmn:process>
</bpmn:definitions>