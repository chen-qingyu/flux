<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_CombineQuantityRestore" targetNamespace="http://bpmn.io/schema/bpmn">
    <bpmn:process id="Process_CombineQuantityRestore" isExecutable="true">
        <bpmn:startEvent id="Event_quantity_restore" name="外部发生器">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_initiatorType" value="external" />
                    <camunda:property name="_entityType" value="order" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:outgoing>Flow_start_combine</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_start_combine" sourceRef="Event_quantity_restore" targetRef="Activity_combine" />
        <bpmn:task id="Activity_combine" name="数量合并">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_taskType" value="combine" />
                    <camunda:property name="_method" value="ratio" />
                    <camunda:property name="_ratio" value="5" />
                    <camunda:property name="_distributionType" value="static" />
                    <camunda:property name="_staticInterval" value="3" />
                    <camunda:property name="_entityType" value="bundle" />
                    <camunda:property name="_useQuantityProperty" value="true" />
                    <camunda:property name="_quantity" value="qty" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_start_combine</bpmn:incoming>
            <bpmn:outgoing>Flow_combine_restore</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="Flow_combine_restore" sourceRef="Activity_combine" targetRef="Activity_restore" />
        <bpmn:task id="Activity_restore" name="还原">
            <bpmn:extensionElements>
                <camunda:properties>
                    <camunda:property name="_taskType" value="split" />
                    <camunda:property name="_method" value="restore" />
                    <camunda:property name="_oneOff" value="true" />
                    <camunda:property name="_distributionType" value="static" />
                    <camunda:property name="_staticInterval" value="0" />
                </camunda:properties>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_combine_restore</bpmn:incoming>
            <bpmn:outgoing>Flow_restore_end</bpmn:outgoing>
        </bpmn:task>
        <bpmn:sequenceFlow id="Flow_restore_end" sourceRef="Activity_restore" targetRef="Event_end" />
        <bpmn:endEvent id="Event_end" name="结束">
            <bpmn:incoming>Flow_restore_end</bpmn:incoming>
        </bpmn:endEvent>
    </bpmn:process>
</bpmn:definitions>